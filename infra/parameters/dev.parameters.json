{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "appServiceContainerBackendName": {
            "value": "mridella-asc-backend2" 
        },
        "appServicePlanName": {
            "value": "mridella-asp2" 
        },
        "containerRegistryName": {
            "value": "mridellaacr2" 
        },
        "postgreSQLDatabaseName": {
            "value": "mridella-db2" 
        },
        "postgreSQLServerName": {
            "value": "mridella-dbsrv2" 
        },
        "keyVaultName": {
            "value": "mridella-kv2" 
        },
        "userAlias": {
            "value": "mridella" 
        },
        "administratorLogin": {
        "value": "${{ secrets.DBUSER }}"
        },
        "administratorPassword": {
        "value": "${{ secrets.DBPASS }}"
        }
    }
}