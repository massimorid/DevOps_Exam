{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        // Exercise II (option JSON parameters): Add parameters to deploy the infrastructure. The names for the Azure resources must start with your student alias
        "appServiceContainerBackendName": {
            "value": "{alias}-asc-backend" //Replace {alias} with your student alias to avoid deployment conflicts (e.g. alias of 'aguadamillas@faculty.ie.edu' is 'aguadamillas')
        },
        "appServicePlanName": {
            "value": "{alias}-asp" //Replace {alias} with your student alias to avoid deployment conflicts (e.g. alias of 'aguadamillas@faculty.ie.edu' is 'aguadamillas')
        },
        "containerRegistryName": {
            "value": "{alias}acr" //Replace {alias} with your student alias to avoid deployment conflicts (e.g. alias of 'aguadamillas@faculty.ie.edu' is 'aguadamillas')
        },
        "postgreSQLDatabaseName": {
            "value": "{alias}-db" //Replace {alias} with your student alias to avoid deployment conflicts (e.g. alias of 'aguadamillas@faculty.ie.edu' is 'aguadamillas')
        },
        "postgreSQLServerName": {
            "value": "{alias}-dbsrv" //Replace {alias} with your student alias to avoid deployment conflicts (e.g. alias of 'aguadamillas@faculty.ie.edu' is 'aguadamillas')
        }
    }
}